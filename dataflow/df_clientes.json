{
	"name": "df_clientes",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "clientes_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "split1"
				},
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          cliente_id as string,",
				"          nombre as string,",
				"          email as string,",
				"          telefono as string,",
				"          ciudad as string,",
				"          fecha_registro as string,",
				"          segmento as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(nombre = initCap(trim(nombre)),",
				"          email = lower(trim(email)),",
				"          ciudad = iif(ciudad == 'SCZ', 'Santa Cruz de la Sierra', initCap(trim(ciudad)))) ~> derivedColumn1",
				"derivedColumn1 split(!isNull(cliente_id) && !isNull(nombre) && !isNull(email) && like(email, '%@%.%'),",
				"     disjoint: false) ~> split1@(validos, rechazados)",
				"split1@validos aggregate(groupBy(cliente_id),",
				"     nombre = first(nombre),",
				"          email = first(email),",
				"          telefono = first(telefono),",
				"          ciudad = first(ciudad),",
				"          segmento = first(segmento)) ~> aggregate1"
			]
		}
	}
}