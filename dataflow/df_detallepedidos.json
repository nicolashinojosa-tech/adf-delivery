{
	"name": "df_detallepedidos",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "detallepedidos_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "split1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          detalle_id as string,",
				"          pedido_id as string,",
				"          producto_id as string,",
				"          cantidad as string,",
				"          precio_unitario as string,",
				"          descuento_linea as string,",
				"          total_linea as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(precio_unitario = replace(toString(precio_unitario), ',', '.'),",
				"          total_linea = (toInteger(cantidad) * toDecimal(replace(toString(precio_unitario), ',', '.'), 10, 2)) - toDecimal(descuento_linea, 10, 2)) ~> derivedColumn1",
				"derivedColumn1 split(toInteger(cantidad) > 0 && !isNull(pedido_id) && !isNull(producto_id),",
				"     disjoint: false) ~> split1@(validos, rechazados)"
			]
		}
	}
}